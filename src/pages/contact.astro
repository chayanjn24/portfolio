---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealLines from '@components/RevealLines.astro';
import { site } from '@content/site';
import { contact } from '@content/contact';
import { rich } from '@lib/text';

const { form } = contact;
---

<BaseLayout title="Contact" footerCta={false}>
  <section class="page-hero contact">
    <div class="stack" style="gap:20px">
      <span class="label">{contact.label}</span>
      <h1 class="title serif"><RevealLines lines={contact.headline} /></h1>
    </div>

    <div class="grid">
      <div class="stack" style="gap:28px">
        <p class="lead serif" data-reveal="fade" set:html={rich(contact.lead)} />
        <div class="links">
          <button type="button" class="link-row serif" data-copy={site.email}>
            <span class="email">{site.email}</span>
            <span class="label label--sm" data-copy-label>Copy</span>
          </button>
          <a href={site.linkedin} target="_blank" rel="noopener" class="link-row serif"><span>LinkedIn</span><span class="arrow">↗</span></a>
          <a href={site.github} target="_blank" rel="noopener" class="link-row serif"><span>GitHub</span><span class="arrow">↗</span></a>
          <a href="/resume" data-label="Résumé" class="link-row serif"><span>Résumé</span><span class="arrow">↗</span></a>
        </div>
        <span class="label label--sm" style="line-height:1.7">{contact.locations}</span>
      </div>

      <form class="card" data-reveal="fade" data-delay="150" data-mail-form data-email={site.email}>
        <div class="card-head">
          <span class="card-title serif">{form.title}</span>
          <span class="label label--sm">{form.note}</span>
        </div>
        <fieldset class="stack" style="gap:12px">
          <legend class="label label--sm">{form.topicLabel}</legend>
          <div class="topics">
            {
              form.topics.map((t, i) => (
                <label class="topic">
                  <input type="radio" name="topic" value={t} checked={i === 0} />
                  <span>{t}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <label class="field">
          <span class="label label--sm">{form.nameLabel}</span>
          <input name="name" placeholder={form.namePlaceholder} autocomplete="name" class="serif" />
        </label>
        <label class="field">
          <span class="label label--sm">{form.messageLabel}</span>
          <textarea name="message" rows="4" placeholder={form.messagePlaceholder} class="serif" data-lenis-prevent></textarea>
        </label>
        <button type="submit" class="pill pill--solid submit" data-magnetic>{form.submit}</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Click-to-copy email.
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyLabel = copyBtn?.querySelector<HTMLElement>('[data-copy-label]');
  let timer = 0;
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copy!);
    } catch {}
    if (!copyLabel) return;
    copyLabel.textContent = 'Copied ✓';
    clearTimeout(timer);
    timer = window.setTimeout(() => (copyLabel.textContent = 'Copy'), 1600);
  });

  // Form → mailto: link with subject "<topic> — from <name>".
  const formEl = document.querySelector<HTMLFormElement>('[data-mail-form]');
  formEl?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(formEl);
    const name = String(data.get('name') || '').trim() || 'your portfolio';
    const subject = `${data.get('topic')} — from ${name}`;
    const body = String(data.get('message') || '');
    window.location.href = `mailto:${formEl.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact {
    padding-bottom: clamp(80px, 10vw, 140px);
    gap: clamp(56px, 7vw, 110px);
    background: radial-gradient(55% 50% at 20% 20%, rgba(255, 77, 0, 0.13), rgba(11, 10, 9, 0) 70%);
  }
  .title {
    margin: 0;
    font-size: clamp(96px, 17vw, 280px);
    line-height: 0.82;
    letter-spacing: -0.03em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(48px, 6vw, 96px);
    align-items: start;
  }
  .lead {
    margin: 0;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.15;
    max-width: 26ch;
    text-wrap: pretty;
  }
  .links {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }
  .link-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    padding: 22px 0;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--line);
    color: var(--text);
    cursor: pointer;
    text-align: left;
    font-size: clamp(26px, 2.8vw, 42px);
    transition: color 0.3s;
  }
  .link-row:hover {
    color: var(--accent);
  }
  .email {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .arrow {
    font-family: var(--mono);
    font-size: 14px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 32px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(24px, 3vw, 44px);
    background: var(--surface);
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .card-title {
    font-size: clamp(32px, 3vw, 44px);
    line-height: 1;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend {
    padding: 0;
    margin-bottom: 12px;
  }
  .topics {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .topic input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .topic span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 99px;
    border: 1px solid var(--line-strong);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
  }
  .topic input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .topic input:focus-visible + span {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .field input,
  .field textarea {
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    font-size: 30px;
    outline: none;
    transition: border-color 0.3s;
  }
  .field textarea {
    font-size: 26px;
    line-height: 1.3;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    border-bottom-color: var(--accent);
  }
  .field ::placeholder {
    color: var(--faint);
  }
  .submit {
    align-self: flex-start;
    border: 0;
  }
</style>
