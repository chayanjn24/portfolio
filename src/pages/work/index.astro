---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RevealLines from '@components/RevealLines.astro';
import StatusBadge from '@components/StatusBadge.astro';
import { projects, workFilters, workPage } from '@content/projects';
import type { Project } from '@content/types';
import { projectHref } from '@lib/projects';
import { fill, rich } from '@lib/text';

const matches = (p: Project, key: string) =>
  key === 'All' ||
  (key === 'Shipped' ? p.status === 'shipped' : key === 'Queue' ? p.status !== 'shipped' : p.cats.includes(key));

const filters = workFilters.map((key) => ({ key, count: projects.filter((p) => matches(p, key)).length }));
// Each row lists the filter keys it belongs to, so the client script only toggles visibility.
const rows = projects.map((p) => ({ p, keys: workFilters.filter((k) => matches(p, k)).join('|') }));
---

<BaseLayout title="Work">
  <section class="page-hero work">
    <div class="top">
      <div class="stack" style="gap:20px">
        <span class="label">{fill(workPage.label)}</span>
        <h1 class="title serif"><RevealLines lines={['Work*.*']} /></h1>
      </div>
      <p class="lead serif" data-reveal="fade" set:html={rich(workPage.lead)} />
    </div>

    <div class="filters" role="group" aria-label="Filter projects">
      {
        filters.map((f, i) => (
          <button type="button" class:list={['filter', { 'is-on': i === 0 }]} data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.key}
            <sup>{f.count}</sup>
          </button>
        ))
      }
    </div>

    <div class="table">
      <div class="row-head label label--sm label--faint">
        <span>No.</span><span>Project</span><span class="hide-sm">Stack</span><span class="right">Status</span>
      </div>
      {
        rows.map(({ p, keys }, i) => (
          <a href={projectHref(p)} data-label={p.title} class="row" data-keys={keys} data-reveal="fade" data-delay={Math.min(i, 6) * 70}>
            <span class:list={['num', { shipped: p.status === 'shipped' }]}>{p.num}</span>
            <div class="stack" style="gap:10px;min-width:0">
              <span class="p-title serif">{p.title}</span>
              <span class="p-summary">{p.summary}</span>
            </div>
            <span class="stack-col label label--sm hide-sm">{p.tags.slice(0, 3).join(' · ')}</span>
            <span class="right">
              <StatusBadge project={p} />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-keys]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter!;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      rows.forEach((r) => (r.hidden = !r.dataset.keys!.split('|').includes(key)));
    }),
  );
</script>

<style>
  .work {
    gap: clamp(28px, 3.2vw, 48px);
    background: radial-gradient(50% 40% at 85% 0%, rgba(var(--accent-rgb), 0.12), rgba(var(--bg-rgb), 0) 70%);
  }
  .top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 32px;
    align-items: end;
  }
  .title {
    margin: 0;
    font-size: clamp(80px, 11vw, 176px);
    line-height: 0.82;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0;
    justify-self: end;
    max-width: 30ch;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.15;
    text-wrap: pretty;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filter {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 99px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
  }
  .filter:hover {
    border-color: var(--accent);
  }
  .filter.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .filter sup {
    font-size: 9px;
    opacity: 0.7;
  }

  .table {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }
  .row-head,
  .row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 220px) 130px;
    gap: 8px 20px;
  }
  .row-head {
    padding: 0 0 12px;
  }
  .row {
    align-items: baseline;
    padding: clamp(18px, 2.2vw, 30px) 0;
    border-top: 1px solid var(--line);
    color: var(--text);
    transition:
      padding 0.6s var(--ease-out),
      background 0.4s;
  }
  .row[hidden] {
    display: none;
  }
  .row:hover {
    padding-left: 20px;
    padding-right: 20px;
    background: var(--surface-2);
    color: var(--text);
  }
  .num {
    font-size: 11px;
    color: var(--muted);
  }
  .num.shipped {
    color: var(--accent);
  }
  .p-title {
    font-size: clamp(32px, 4.4vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .p-summary {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 62ch;
  }
  .stack-col {
    line-height: 1.7;
    letter-spacing: 0.06em;
  }
  .right {
    justify-self: end;
    text-align: right;
  }

  @media (max-width: 760px) {
    .row-head,
    .row {
      grid-template-columns: 36px minmax(0, 1fr) auto;
    }
    .hide-sm {
      display: none;
    }
  }
</style>
