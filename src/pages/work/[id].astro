---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '@components/ImageSlot.astro';
import StatusBadge from '@components/StatusBadge.astro';
import TableauEmbed from '@components/TableauEmbed.astro';
import QuickJump from '@components/QuickJump.astro';
import { projects } from '@content/projects';
import { site } from '@content/site';
import type { Project } from '@content/types';
import { nextProject, projectHref } from '@lib/projects';
import { pad2 } from '@lib/text';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}

interface Props {
  p: Project;
}
const { p } = Astro.props;
const isShipped = p.status === 'shipped';
const next = nextProject(p);
const hasFigure = isShipped;
// Section letters follow what's on the page.
const letters = 'ABCDEF';
let n = 0;
const L = () => `(${letters[n++]})`;
// Quick-jump items, lettered in the same order as the sections below.
const jump = [
  { id: 'question', name: 'The question', on: true },
  { id: 'approach', name: isShipped ? 'What I did' : 'The plan', on: true },
  { id: 'results', name: 'Results', on: isShipped },
  { id: 'live', name: 'Explore it live', on: !!p.dashboards?.length },
]
  .filter((s) => s.on)
  .map((s, i) => ({ id: s.id, label: `(${letters[i]}) ${s.name}` }));
---

<BaseLayout title={p.title} description={p.summary} footerCta={false}>
  <section class="page-hero hero">
    <div class="topbar label">
      <a href="/work" data-label="Work" class="back">← All work</a>
      <StatusBadge project={p} long />
    </div>
    <div class="stack" style="gap:20px">
      <span class="label kind">({p.num}) {p.kind}</span>
      <h1 class="title serif">{p.title}</h1>
    </div>
    <div class="meta">
      <div class="col wide">
        <span class="label label--sm label--faint">Summary</span>
        <span class="summary serif">{p.summary}</span>
      </div>
      <div class="col">
        <span class="label label--sm label--faint">Stack</span>
        <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
      </div>
      <div class="col">
        <span class="label label--sm label--faint">{isShipped ? 'Status' : 'Planned'}</span>
        <span class="small">{isShipped ? 'Shipped · live' : p.when}</span>
        {p.hobby && <a href="/about" data-label="About" class="fuel">Fuelled by {p.hobby} ↗</a>}
      </div>
      {
        p.links && p.links.length > 0 && (
          <div class="col">
            <span class="label label--sm label--faint">Links</span>
            <div class="meta-links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="meta-link">
                  {l.label} ↗
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <QuickJump items={jump} />

  <section class="case">
    <div class="stack question-col" id="question" style="gap:20px">
      <span class="label">{L()} The question</span>
      <p class="question serif" data-reveal="fade">{p.question}</p>
      {
        hasFigure && (
          <figure class="figure" data-reveal="wipe">
            {p.cover ? (
              <button type="button" class="zoom" data-zoom aria-label={`Enlarge the ${p.title} screenshot`}>
                <ImageSlot src={p.cover} alt={`${p.title} screenshot`} placeholder={p.coverPlaceholder ?? p.title} ratio="16/10" natural loading="eager" />
                <span class="zoom-hint label label--sm">⤢ Click to enlarge</span>
              </button>
            ) : (
              <ImageSlot placeholder={p.coverPlaceholder ?? p.title} ratio="16/10" />
            )}
          </figure>
        )
      }
    </div>
    <div class="stack" id="approach" style="gap:20px">
      <span class="label">{L()} {isShipped ? 'What I did' : 'The plan'}</span>
      <ol class="steps">
        {
          p.steps.map((s, i) => (
            <li data-reveal="fade" data-delay={i * 80}>
              <span class="step-n">{pad2(i + 1)}</span>
              <span>{s}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    isShipped && (
      <section class="results" id="results">
        <span class="label">{L()} Results</span>
        <div class="stats">
          {(p.results ?? []).map(([value, label], i) => (
            <div class="stat" data-reveal="fade" data-delay={i * 100}>
              <span class="stat__value">{value}</span>
              <span class="stat__label">{label}</span>
            </div>
          ))}
        </div>
        <div class="links">
          {(p.links ?? []).map((l) => (
            <a href={l.href} target="_blank" rel="noopener" data-magnetic class="pill pill--solid">
              {l.label} ↗
            </a>
          ))}
        </div>
      </section>
    )
  }

  {p.dashboards && p.dashboards.length > 0 && <TableauEmbed id="live" dashboards={p.dashboards} label={`${L()} Explore it live`} />}

  {
    !isShipped && (
      <section class="status-wrap">
        <div class="status">
          <div class="col">
            <span class="label label--sm label--faint">Build window</span>
            <span class="when serif">{p.when}</span>
          </div>
          <div class="col">
            <span class="label label--sm label--faint">Done when</span>
            <span class="body">{p.done}</span>
          </div>
          <a href={site.github} target="_blank" rel="noopener" data-magnetic class="pill follow">
            Follow on GitHub ↗
          </a>
        </div>
      </section>
    )
  }

  {
    p.cover && (
      <dialog class="lightbox" data-lightbox aria-label={`${p.title} screenshot`}>
        <img src={p.cover} alt={`${p.title} screenshot, full size`} />
        <button type="button" class="close label" data-close aria-label="Close">Close ✕</button>
      </dialog>
    )
  }

  <a href={projectHref(next)} data-label={next.title} class="next">
    <span class="label">Next project — {next.num}</span>
    <span class="next-title serif">{next.title} →</span>
  </a>
</BaseLayout>

<script>
  // Click the screenshot to see it full-screen; Esc, the button or a click outside closes it.
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  document.querySelector('[data-zoom]')?.addEventListener('click', () => dialog?.showModal());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as Element).closest('[data-close]')) dialog.close();
  });
</script>

<style>
  .hero {
    padding-bottom: clamp(28px, 3.5vw, 48px);
    gap: clamp(24px, 3vw, 40px);
    background: radial-gradient(50% 50% at 15% 0%, rgba(var(--accent-rgb), 0.12), rgba(var(--bg-rgb), 0) 70%);
  }
  .topbar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .back {
    color: var(--text-2);
  }
  .kind {
    color: var(--accent);
  }
  .title {
    margin: 0;
    font-size: clamp(52px, 8vw, 128px);
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-wrap: balance;
    max-width: 14ch;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wide {
    grid-column: span 2;
    min-width: 0;
  }
  @media (max-width: 520px) {
    .wide {
      grid-column: 1 / -1;
    }
  }
  .summary {
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .tags {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--text-2);
  }
  .small {
    font-size: 13px;
    color: var(--text-2);
  }
  .fuel {
    font-size: 12px;
    color: var(--accent);
  }

  .case {
    padding: clamp(28px, 3.5vw, 48px) var(--gutter) clamp(56px, 7vw, 112px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(40px, 6vw, 96px);
  }
  .question-col {
    min-width: 0;
  }
  .figure {
    margin: 12px 0 0;
  }
  .zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    text-align: left;
  }
  .zoom-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 6px 10px;
    border-radius: 99px;
    background: rgba(var(--bg-rgb), 0.78);
    color: var(--text);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .zoom:hover .zoom-hint,
  .zoom:focus-visible .zoom-hint {
    opacity: 1;
  }
  @media (hover: none) {
    .zoom-hint {
      opacity: 1;
    }
  }
  .lightbox {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgba(var(--bg-rgb), 0.94);
    color: var(--text);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 99px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
  }
  .meta-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .meta-link {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 99px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.3s;
  }
  .meta-link:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .question {
    margin: 0;
    font-size: clamp(34px, 3.8vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }
  .steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .step-n {
    color: var(--accent);
    font-size: 11px;
    padding-top: 3px;
  }

  .results {
    padding: 0 var(--gutter) clamp(56px, 7vw, 112px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .results .stat {
    padding-bottom: 0;
  }
  .links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .status-wrap {
    padding: 0 var(--gutter) clamp(56px, 7vw, 112px);
  }
  .status {
    border: 1px dashed var(--line-strong);
    border-radius: 6px;
    padding: clamp(24px, 3vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 28px;
    align-items: end;
    background: radial-gradient(60% 100% at 100% 100%, rgba(var(--accent-rgb), 0.12), rgba(var(--bg-rgb), 0));
  }
  .when {
    font-size: clamp(48px, 5vw, 80px);
    line-height: 0.9;
    color: var(--accent);
  }
  .body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .follow {
    justify-self: start;
    min-height: 48px;
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(80px, 10vw, 150px) var(--gutter);
    border-top: 1px solid var(--line);
    color: var(--text);
    transition: background 0.5s;
  }
  .next:hover {
    background: var(--surface-2);
    color: var(--accent);
  }
  .next-title {
    font-style: italic;
    font-size: clamp(56px, 10vw, 168px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
</style>
