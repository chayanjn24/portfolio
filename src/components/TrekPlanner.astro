---
/**
 * The Sahyadri trek planner: map, filters, trek card and ranked table, all linked.
 * Data comes from /data/treks.json, exported by the sahyadri-treks repo (run.py).
 * Click a trail or a table row to select a trek; both views follow.
 */
import 'leaflet/dist/leaflet.css';

interface Props {
  label: string;
  /** Anchor for in-page links (QuickJump). */
  id?: string;
}
const { label, id } = Astro.props;
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<section class="planner" id={id} data-planner>
  <div class="head">
    <span class="label">{label}</span>
    <span class="label label--sm label--faint">Click a trail on the map or a row in the table</span>
  </div>

  <div class="filters">
    <div class="field">
      <span class="label label--sm label--faint">Month</span>
      <div class="chips months" role="group" aria-label="Month">
        {months.map((m, i) => <button type="button" class:list={['chip', { 'is-on': i === 11 }]} data-month={i}>{m}</button>)}
      </div>
    </div>
    <div class="field">
      <span class="label label--sm label--faint">Difficulty</span>
      <div class="chips" role="group" aria-label="Difficulty">
        {['Easy', 'Moderate', 'Hard'].map((g) => (
          <button type="button" class="chip is-on" data-level={g} aria-pressed="true"><i class={`dot dot--${g.toLowerCase()}`}></i>{g}</button>
        ))}
      </div>
    </div>
    <label class="field range">
      <span class="label label--sm label--faint">From Pune, up to <b data-out="pune">120 km</b></span>
      <input type="range" min="20" max="200" step="10" value="120" data-range="pune" />
    </label>
    <label class="field range">
      <span class="label label--sm label--faint">Climb, up to <b data-out="climb">1,100 m</b></span>
      <input type="range" min="200" max="1100" step="50" value="1100" data-range="climb" />
    </label>
  </div>

  <p class="count label label--sm" data-count aria-live="polite"></p>

  <div class="grid">
    <div class="map" data-map data-lenis-prevent aria-label="Map of the treks"></div>
    <aside class="card" data-card aria-live="polite"></aside>
  </div>

  <div class="table-wrap" data-lenis-prevent>
    <table>
      <thead>
        <tr><th>Trek</th><th>Level</th><th data-score-head>Dec score</th><th class="num">Km</th><th class="num hide-sm">Climb</th><th class="num hide-sm">From Pune</th><th class="hide-sm">Region</th></tr>
      </thead>
      <tbody data-rows></tbody>
    </table>
  </div>

  <p class="note label label--sm label--faint">
    Not a navigation or safety tool. Trails come from OpenStreetMap and can be wrong or out of date, and the score can't
    see rock patches, exposure or bad weather. Data: © OpenStreetMap contributors, Copernicus DEM, Open-Meteo.
  </p>
</section>

<script>
  import L from 'leaflet';

  type Trek = {
    name: string; region: string; level: 'Easy' | 'Moderate' | 'Hard'; mine: string | null; traced: boolean;
    km: number; climb: number; top: number; steepest: number; difficulty: number; pune: number;
    nearest: string; nearestKm: number; line: [number, number][]; score: number[]; rainDays: number[];
    high: number[]; profile: [number, number][];
  };

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const root = document.querySelector<HTMLElement>('[data-planner]');

  if (root) init(root);

  async function init(root: HTMLElement) {
    const treks: Trek[] = await fetch('/data/treks.json').then((r) => r.json());
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const state = { month: 11, levels: new Set(['Easy', 'Moderate', 'Hard']), pune: 120, climb: 1100, pick: '' };

    // colours come from CSS, so they follow the light/dark toggle
    const css = (v: string) => getComputedStyle(root).getPropertyValue(v).trim();
    const colour = (t: Trek) => css(`--${t.level.toLowerCase()}`);

    const mapEl = $<HTMLElement>('[data-map]');
    const map = L.map(mapEl, { zoomSnap: 0.25, scrollWheelZoom: false })
      .fitBounds(L.latLngBounds(treks.flatMap((t) => t.line)), { padding: [16, 16] });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 16,
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    // scroll zooms the map only after it has been clicked, so the page still scrolls past it
    map.on('click', () => map.scrollWheelZoom.enable());
    map.on('mouseout', () => map.scrollWheelZoom.disable());
    const layer = L.layerGroup().addTo(map);

    const visible = () =>
      treks
        .filter((t) => state.levels.has(t.level) && t.pune <= state.pune && t.climb <= state.climb)
        .sort((a, b) => b.score[state.month] - a.score[state.month] || a.name.localeCompare(b.name));

    function select(name: string, fly: boolean) {
      state.pick = name;
      render();
      const t = treks.find((x) => x.name === name);
      if (!t || !fly) return;
      map.flyToBounds(L.latLngBounds(t.line).pad(0.6), { maxZoom: 13, duration: 0.8 });
      // on phones the map sits above the table, so bring it into view
      const box = mapEl.getBoundingClientRect();
      if (box.bottom < 80 || box.top > innerHeight - 80) mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function drawMap(list: Trek[]) {
      layer.clearLayers();
      // selected trek last, so it sits on top
      [...list].sort((a, b) => Number(a.name === state.pick) - Number(b.name === state.pick)).forEach((t) => {
        const on = t.name === state.pick;
        const tip = `<b>${t.name}</b><br>${t.level} · ${t.km} km · ${t.climb} m up<br>${MONTHS[state.month]} score ${t.score[state.month]}`;
        if (on) L.polyline(t.line, { color: css('--text'), weight: 11, opacity: 0.85, interactive: false }).addTo(layer);
        const line = L.polyline(t.line, { color: colour(t), weight: on ? 6 : 5, opacity: on ? 1 : 0.8 }).addTo(layer);
        // fat invisible line underneath makes short trails easy to hit
        const hit = L.polyline(t.line, { color: '#000', weight: 22, opacity: 0 }).addTo(layer);
        const dot = L.circleMarker(t.line[0], {
          radius: on ? 8 : 5, color: on ? css('--text') : css('--bg'), weight: 2, fillColor: colour(t), fillOpacity: 1,
        }).addTo(layer);
        for (const l of [line, hit, dot]) {
          l.bindTooltip(tip, { sticky: true, className: 'trek-tip' });
          l.on('click', (e) => { L.DomEvent.stopPropagation(e); select(t.name, false); });
        }
      });
    }

    function profileSvg(t: Trek) {
      const W = 520, H = 150, pad = { l: 40, r: 8, t: 10, b: 22 };
      const xs = t.profile.map((p) => p[0]), ys = t.profile.map((p) => p[1]);
      const x0 = 0, x1 = Math.max(...xs), y0 = Math.min(...ys) - 30, y1 = Math.max(...ys) + 20;
      const sx = (x: number) => pad.l + ((x - x0) / (x1 - x0 || 1)) * (W - pad.l - pad.r);
      const sy = (y: number) => pad.t + (1 - (y - y0) / (y1 - y0)) * (H - pad.t - pad.b);
      const line = t.profile.map((p, i) => `${i ? 'L' : 'M'}${sx(p[0]).toFixed(1)},${sy(p[1]).toFixed(1)}`).join('');
      const area = `${line}L${sx(x1)},${H - pad.b}L${sx(0)},${H - pad.b}Z`;
      const ticks = [y0 + 30, (y0 + y1) / 2, y1 - 20].map((v) => Math.round(v / 10) * 10);
      return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Elevation profile of ${t.name}">
        <defs><linearGradient id="pf" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--accent)" stop-opacity=".35"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/>
        </linearGradient></defs>
        ${ticks.map((v) => `<line x1="${pad.l}" x2="${W - pad.r}" y1="${sy(v)}" y2="${sy(v)}" class="grid-line"/>
          <text x="${pad.l - 6}" y="${sy(v) + 3}" text-anchor="end">${v}</text>`).join('')}
        <path d="${area}" fill="url(#pf)"/><path d="${line}" fill="none" stroke="var(--accent)" stroke-width="2"/>
        <text x="${pad.l}" y="${H - 6}">0 km</text><text x="${W - pad.r}" y="${H - 6}" text-anchor="end">${x1.toFixed(1)} km</text>
      </svg>`;
    }

    function drawCard(t: Trek | undefined) {
      const card = $<HTMLElement>('[data-card]');
      if (!t) {
        card.innerHTML = `<p class="serif empty">Nothing matches. Try a longer drive or more difficulty levels.</p>`;
        return;
      }
      const m = state.month;
      const bars = t.score.map((s, i) => `<div class="bar${i === m ? ' is-on' : ''}" title="${MONTHS[i]}: ${s}/100, ${t.rainDays[i]} rainy days, ${t.high[i]}°C highs">
          <i style="height:${Math.max(s, 3)}%"></i><span>${MONTHS[i][0]}</span></div>`).join('');
      const disagree = t.mine && t.mine !== t.level
        ? `<p class="serif aside">I grade it <em>${t.mine}</em>; the numbers say ${t.level}.</p>` : '';
      card.innerHTML = `
        <span class="label label--sm label--faint"><i class="dot dot--${t.level.toLowerCase()}"></i>${t.region} · ${t.level} · ${t.traced ? 'traced on OSM paths' : 'OSM route'}</span>
        <h3 class="serif name">${t.name}</h3>
        <div class="facts">
          <div><b class="serif">${t.km}</b><span class="label label--sm">km one way</span></div>
          <div><b class="serif">${t.climb}</b><span class="label label--sm">m climb</span></div>
          <div><b class="serif">${t.top}</b><span class="label label--sm">m at the top</span></div>
          <div><b class="serif">${t.steepest}%</b><span class="label label--sm">steepest 100 m</span></div>
          <div><b class="serif">${t.difficulty}</b><span class="label label--sm">difficulty /100</span></div>
          <div><b class="serif accent">${t.score[m]}</b><span class="label label--sm">${MONTHS[m]} score /100</span></div>
        </div>
        <span class="label label--sm label--faint">Elevation</span>
        ${profileSvg(t)}
        <span class="label label--sm label--faint">Month score</span>
        <div class="bars">${bars}</div>
        <p class="serif aside">${t.pune} km from Pune. Pair it with <em>${t.nearest}</em>, ${t.nearestKm} km away.</p>
        ${disagree}`;
    }

    function drawTable(list: Trek[]) {
      $<HTMLElement>('[data-score-head]').textContent = `${MONTHS[state.month]} score`;
      $<HTMLElement>('[data-rows]').innerHTML = list.map((t) => `
        <tr data-name="${t.name}" class="${t.name === state.pick ? 'is-on' : ''}" tabindex="0">
          <td><i class="dot dot--${t.level.toLowerCase()}"></i>${t.name}</td><td>${t.level}</td>
          <td><span class="meter"><i style="width:${t.score[state.month]}%"></i></span>${t.score[state.month]}</td>
          <td class="num">${t.km}</td><td class="num hide-sm">${t.climb} m</td><td class="num hide-sm">${t.pune} km</td><td class="hide-sm">${t.region}</td>
        </tr>`).join('');
    }

    function render() {
      const list = visible();
      if (!list.some((t) => t.name === state.pick)) state.pick = list[0]?.name ?? '';
      $<HTMLElement>('[data-count]').textContent =
        `${list.length} of ${treks.length} treks · best for ${MONTHS[state.month]} first`;
      drawMap(list);
      drawCard(list.find((t) => t.name === state.pick));
      drawTable(list);
    }

    // filters
    root.querySelectorAll<HTMLButtonElement>('[data-month]').forEach((b) =>
      b.addEventListener('click', () => {
        state.month = Number(b.dataset.month);
        root.querySelectorAll('[data-month]').forEach((x) => x.classList.toggle('is-on', x === b));
        render();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((b) =>
      b.addEventListener('click', () => {
        const g = b.dataset.level!;
        if (state.levels.has(g) && state.levels.size === 1) return; // keep at least one
        state.levels.has(g) ? state.levels.delete(g) : state.levels.add(g);
        b.classList.toggle('is-on', state.levels.has(g));
        b.setAttribute('aria-pressed', String(state.levels.has(g)));
        render();
      }),
    );
    root.querySelectorAll<HTMLInputElement>('[data-range]').forEach((r) =>
      r.addEventListener('input', () => {
        const k = r.dataset.range as 'pune' | 'climb';
        state[k] = Number(r.value);
        $<HTMLElement>(`[data-out="${k}"]`).textContent = k === 'pune' ? `${r.value} km` : `${Number(r.value).toLocaleString('en-IN')} m`;
        render();
      }),
    );

    // table rows select the trek and fly the map to it
    const rows = $<HTMLElement>('[data-rows]');
    const pickRow = (e: Event) => {
      const tr = (e.target as HTMLElement).closest<HTMLElement>('tr[data-name]');
      if (tr) select(tr.dataset.name!, true);
    };
    rows.addEventListener('click', pickRow);
    rows.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pickRow(e); } });

    // redraw line colours when the theme changes
    new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    new ResizeObserver(() => map.invalidateSize()).observe(mapEl);

    render();
  }
</script>

<style>
  .planner {
    --easy: #9cc48a;
    --moderate: #f2b33d;
    --hard: var(--accent);
    padding: 0 var(--gutter) clamp(80px, 10vw, 150px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  :global(:root[data-theme='light']) .planner {
    --easy: #4f8a3c;
    --moderate: #b67d00;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* filters */
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px 32px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .field b {
    color: var(--text);
    font-weight: 500;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    min-height: 34px;
    padding: 0 12px;
    border-radius: 99px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text-2);
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s;
  }
  .months .chip {
    min-width: 46px;
    justify-content: center;
    padding: 0 8px;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .chip.is-on {
    border-color: var(--accent);
    color: var(--text);
    background: rgba(var(--accent-rgb), 0.14);
  }
  .months .chip.is-on {
    background: var(--accent);
    color: var(--bg);
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
  .count {
    margin: 0;
  }

  /* map + card */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .map {
    min-height: 620px;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    z-index: 0;
  }
  /* the standard OSM tiles, darkened to sit in the dark theme */
  :global(:root:not([data-theme='light'])) .map :global(.leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.85) saturate(0.4);
  }
  /* and toned down on the light "paper" theme */
  :global(:root[data-theme='light']) .map :global(.leaflet-tile-pane) {
    filter: saturate(0.55) sepia(0.12) brightness(1.02);
  }
  /* Leaflet brightens tile edges (plus-lighter) to hide seams, which the invert above
     turns into dark lines. Overlap tiles by half a pixel instead. */
  .map :global(img.leaflet-tile) {
    mix-blend-mode: normal;
    width: 256.5px !important;
    height: 256.5px !important;
  }
  .map:global(.leaflet-container) {
    font-family: var(--mono);
    background: var(--surface);
  }
  .map :global(.leaflet-control-attribution) {
    background: rgba(var(--surface-rgb), 0.8);
    color: var(--muted);
    font-size: 10px;
  }
  .map :global(.leaflet-control-attribution a) {
    color: var(--text-2);
  }
  .map :global(.leaflet-bar a) {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--line);
  }
  :global(.trek-tip) {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font: 11px/1.5 var(--mono);
    box-shadow: none;
  }
  :global(.trek-tip::before) {
    display: none;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 24px 26px;
    background: rgba(var(--surface-rgb), 0.6);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .card :global(.name) {
    margin: 2px 0 4px;
    font-size: clamp(40px, 4vw, 60px);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .card :global(.facts) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 18px;
    margin-bottom: 8px;
  }
  .card :global(.facts b) {
    display: block;
    font-size: 30px;
    line-height: 1;
    margin-bottom: 6px;
  }
  .card :global(.facts .accent) {
    color: var(--accent);
  }
  .card :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .card :global(svg text) {
    fill: var(--muted);
    font: 10px var(--mono);
  }
  .card :global(.grid-line) {
    stroke: var(--hairline);
  }
  .card :global(.bars) {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 5px;
    height: 84px;
  }
  .card :global(.bar) {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
  }
  .card :global(.bar i) {
    width: 100%;
    border-radius: 2px 2px 0 0;
    background: var(--line-strong);
  }
  .card :global(.bar.is-on i) {
    background: var(--accent);
  }
  .card :global(.bar span) {
    font-size: 9px;
    color: var(--muted);
  }
  .card :global(.aside) {
    margin: 4px 0 0;
    font-size: 19px;
    font-style: italic;
    line-height: 1.3;
    color: var(--text-2);
  }
  .card :global(.aside em) {
    color: var(--accent);
  }
  .card :global(.empty) {
    font-size: 22px;
    color: var(--text-2);
  }
  .dot,
  .planner :global(.dot) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: 1px;
  }
  .planner :global(.dot--easy) {
    background: var(--easy);
  }
  .planner :global(.dot--moderate) {
    background: var(--moderate);
  }
  .planner :global(.dot--hard) {
    background: var(--hard);
  }

  /* table */
  .table-wrap {
    max-height: 460px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  th {
    position: sticky;
    top: 0;
    background: var(--surface-2);
    text-align: left;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  table :global(td) {
    padding: 11px 14px;
    border-bottom: 1px solid var(--hairline);
    color: var(--text-2);
    white-space: nowrap;
  }
  table :global(tr[data-name]) {
    cursor: pointer;
    transition: background 0.2s;
  }
  table :global(tr[data-name]:hover) {
    background: rgba(var(--accent-rgb), 0.06);
  }
  table :global(tr.is-on) {
    background: rgba(var(--accent-rgb), 0.12);
  }
  table :global(tr.is-on td) {
    color: var(--text);
  }
  table :global(tr.is-on td:first-child) {
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .num,
  table :global(td.num) {
    text-align: right;
  }
  table :global(.meter) {
    display: inline-block;
    width: 70px;
    height: 4px;
    margin-right: 10px;
    border-radius: 2px;
    background: var(--line);
    vertical-align: middle;
    overflow: hidden;
  }
  table :global(.meter i) {
    display: block;
    height: 100%;
    background: var(--accent);
  }
  .note {
    margin: 0;
    max-width: 900px;
    line-height: 1.7;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1000px) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .map {
      min-height: 420px;
    }
  }
  @media (max-width: 600px) {
    .filters {
      grid-template-columns: 1fr;
    }
    .hide-sm,
    table :global(.hide-sm) {
      display: none;
    }
    .card :global(.facts) {
      grid-template-columns: repeat(2, 1fr);
    }
    th,
    table :global(td) {
      padding-left: 8px;
      padding-right: 8px;
    }
