---
import { game } from '@content/home';
import { rich } from '@lib/text';
import RevealLines from '@components/RevealLines.astro';

const config = {
  badRows: game.badRows,
  ranks: game.ranks,
  startLabel: game.startLabel,
  rerunLabel: game.rerunLabel,
  shieldLabel: game.shieldLabel,
  shieldOn: game.shieldOn,
  shieldUsed: game.shieldUsed,
  promoted: game.promoted,
};
---

<section class="section" id="game" data-runner data-config={JSON.stringify(config)}>
  <div class="head">
    <div class="stack" style="gap:20px">
      <span class="label">{game.label} — best <span data-best>0</span></span>
      <h2 class="h2 title"><RevealLines lines={[game.title]} /></h2>
    </div>
    <div class="intro" data-reveal="fade">
      <p class="serif">{game.intro}</p>
      <span class="label label--sm">{game.controls}</span>
      <button type="button" class="mute label label--sm" data-mute aria-pressed="false">🔊 Sound on</button>
    </div>
  </div>

  <div class="stage" data-stage tabindex="0" role="application" aria-label="Row Runner game. Press Enter to start, Space to jump.">
    <canvas></canvas>
    <div class="overlay" data-overlay>
      <div class="stack over" data-over hidden>
        <span class="label crash-line">Pipeline crashed · <span class="nowrap"><span data-out="rows"></span> clean rows</span> · <span class="nowrap"><span data-out="dist"></span>&nbsp;m</span></span>
        <span class="score serif"><span data-out="score"></span> <em>pts</em></span>
        <span class="rank serif">Rank — <span data-out="rank"></span></span>
      </div>
      <span class="idle serif" data-idle set:html={rich(game.idleTitle)} />
      <span class="pill pill--solid" data-start>{game.startLabel}</span>
    </div>
  </div>
</section>

<script>
  import { initRowRunner } from '../../scripts/row-runner';
  const el = document.querySelector<HTMLElement>('[data-runner]');
  if (el) initRowRunner(el);
</script>

<style>
  .head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 32px;
    align-items: end;
  }
  .title {
    font-size: clamp(72px, 11vw, 180px);
    line-height: 0.85;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 46ch;
  }
  .intro p {
    margin: 0;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.25;
    text-wrap: pretty;
  }
  .stage {
    position: relative;
    height: clamp(320px, 38vw, 480px);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg);
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    /* no blue flash on tap (phones), no focus ring on click; keyboard focus still shows */
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .stage:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
  }
  .stage *,
  .mute {
    -webkit-tap-highlight-color: transparent;
  }
  /* while running, swipes on the game don't scroll the page by accident */
  .stage:global(.is-running) {
    touch-action: none;
  }
  .mute {
    align-self: flex-start;
    padding: 8px 14px;
    border-radius: 99px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .mute:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 24px;
    background: rgba(var(--bg-rgb), 0.78);
    backdrop-filter: blur(4px);
    text-align: center;
  }
  .overlay[hidden],
  [data-over][hidden],
  [data-idle][hidden] {
    display: none;
  }
  .over {
    align-items: center;
    gap: 20px;
  }
  .crash-line {
    text-wrap: balance;
  }
  .nowrap {
    white-space: nowrap;
  }
  .score {
    font-size: clamp(64px, 9vw, 128px);
    line-height: 0.85;
    color: var(--accent);
  }
  .rank {
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 32px);
  }
  .idle {
    font-size: clamp(36px, 5vw, 68px);
    line-height: 0.95;
    max-width: 14ch;
  }
</style>
