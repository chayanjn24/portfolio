---
import { site } from '@content/site';
import { hero } from '@content/home';
import RevealLines from '@components/RevealLines.astro';
---

<section
  class="hero"
  data-hero
  data-labels={JSON.stringify(hero.shapeLabels)}
  data-first={site.firstName}
  data-last={site.lastName}
>
  <canvas aria-hidden="true"></canvas>
  <h1 class="sr-only">{site.fullName} — {site.role}</h1>
  <div class="overlay">
    <div class="meta label">
      {hero.meta.map((m) => <span>{m}</span>)}
      <span class="fig">fig. <span data-fig-n>01</span> — <span class="accent" data-fig-label>{hero.shapeLabels[0]}</span></span>
    </div>
    <div class="bottom">
      <p class="headline serif">
        <RevealLines lines={hero.headline} />
      </p>
      <div class="bio" data-reveal="fade" data-delay="250">
        <span>{hero.bio}</span>
        <span class="hints label label--sm">{hero.hints.map((h) => <span>{h}</span>)}</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroField } from '../../scripts/hero-field';
  const el = document.querySelector<HTMLElement>('[data-hero]');
  if (el) initHeroField(el);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: radial-gradient(55% 45% at 50% 52%, rgba(var(--accent-rgb), 0.11), rgba(var(--bg-rgb), 0) 70%);
    cursor: crosshair;
    touch-action: pan-y;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    margin: 0;
  }
  .overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(92px, 11vh, 130px) var(--gutter) clamp(24px, 4vh, 44px);
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 8px 24px;
  }
  .fig {
    color: var(--text);
  }
  .accent {
    color: var(--accent);
  }
  .bottom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px 48px;
    align-items: end;
  }
  .headline {
    margin: 0;
    font-size: clamp(34px, 3.8vw, 60px);
    line-height: 1;
    letter-spacing: -0.01em;
    max-width: 15ch;
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-self: end;
    max-width: 40ch;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .hints {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
</style>
