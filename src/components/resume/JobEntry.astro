---
import type { Job } from '@content/types';
import { rich } from '@lib/text';

interface Props {
  job: Job;
}
const { job } = Astro.props;
---

<article class="job">
  <div class="job-head">
    <div class="stack" style="gap:6px">
      <span class="org serif">{job.org}</span>
      <span class="label label--sm">{job.role} · {job.location}</span>
    </div>
    <span class="when">{job.when}</span>
  </div>
  {job.context && <p class="context">{job.context}</p>}
  {
    job.groups.map((g) => (
      <div class="group">
        {g.title && <span class="group-title label label--sm">{g.title}</span>}
        <ul class="points">
          {g.points.map((pt) => (
            <li>
              <span class="dash">—</span>
              <span set:html={rich(pt)} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  {
    job.link && (
      <a href={job.link.href} target="_blank" rel="noopener" class="ext label label--sm">
        {job.link.label} ↗
      </a>
    )
  }
</article>

<style>
  .job {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .org {
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1;
  }
  .when {
    font-size: 12px;
    color: var(--accent);
    white-space: nowrap;
  }
  .context {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 70ch;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }
  .group-title {
    color: var(--text);
  }
  .points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .points li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    padding: 12px 0;
    border-top: 1px solid var(--hairline);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }
  /* Key phrase: brighter, upright — the web version of the PDF's bold spans. */
  .points :global(em) {
    font-style: normal;
    color: var(--text);
  }
  .dash {
    color: var(--accent);
  }
  .ext {
    align-self: flex-start;
    color: var(--accent);
  }

  @media print {
    .job {
      gap: 6px;
    }
    .job-head {
      break-after: avoid;
    }
    .org {
      font-size: 18px;
    }
    .when {
      font-size: 10px;
    }
    .context {
      display: none;
    }
    .points li {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }
    .group {
      margin-top: 4px;
      gap: 0;
      break-inside: avoid;
    }
    .points li {
      padding: 3px 0;
      font-size: 10px;
      line-height: 1.4;
    }
    .points :global(em) {
      font-weight: 500;
    }
    .ext {
      display: none;
    }
  }
</style>
