---
/**
 * Sticky in-page index for long pages. Sits just under the fixed nav as a slim
 * row of mono labels (a swipeable chip row on phones). The section on screen is
 * highlighted; clicks go through the site-wide same-page anchor handler in fx.ts.
 */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav class="qj no-print" aria-label="On this page" data-qj>
      <ol>
        {items.map((it) => (
          <li>
            <a href={`#${it.id}`} data-qj-link={it.id}>
              {it.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  const bar = document.querySelector<HTMLElement>('[data-qj]');
  if (bar) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('[data-qj-link]')];
    const targets = links.map((a) => document.getElementById(a.dataset.qjLink!)).filter((t): t is HTMLElement => !!t);

    // Land sections just below the nav + this bar.
    const setMargin = () => {
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      if (nav) bar.style.top = `${nav.offsetHeight - 1}px`;
      const off = bar.getBoundingClientRect().height + (parseFloat(getComputedStyle(bar).top) || 0) + 16;
      targets.forEach((t) => (t.style.scrollMarginTop = `${off}px`));
    };
    setMargin();
    window.addEventListener('resize', setMargin, { passive: true });

    const setActive = (id: string) =>
      links.forEach((a) => {
        const on = a.dataset.qjLink === id;
        a.classList.toggle('is-active', on);
        if (on) {
          a.setAttribute('aria-current', 'true');
          // keep the active chip in view on the phone row
          const ol = a.closest('ol')!;
          const x = a.offsetLeft - (ol.clientWidth - a.offsetWidth) / 2;
          ol.scrollTo({ left: x, behavior: 'smooth' });
        } else a.removeAttribute('aria-current');
      });

    // The active section is the last one whose top has passed the upper third of the screen.
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => (en.isIntersecting ? visible.add(en.target) : visible.delete(en.target)));
        const current = targets.filter((t) => visible.has(t)).at(0);
        if (current) setActive(current.id);
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    targets.forEach((t) => io.observe(t));

    // Show the bar once the page header is scrolled past.
    const onScroll = () => bar.classList.toggle('is-stuck', bar.getBoundingClientRect().top <= (parseFloat(getComputedStyle(bar).top) || 0) + 1);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .qj {
    position: sticky;
    top: 64px; /* replaced by the nav's measured height */
    z-index: 50;
    margin: 0 var(--gutter);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.4s var(--ease-out),
      margin 0.4s var(--ease-out),
      padding 0.4s var(--ease-out);
  }
  .qj.is-stuck {
    margin: 0;
    padding: 0 var(--gutter);
    border-top-color: transparent;
    background: rgba(var(--bg-rgb), 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(16px, 2.4vw, 36px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  ol::-webkit-scrollbar {
    display: none;
  }
  li {
    flex: none;
  }
  a {
    position: relative;
    display: block;
    padding: 13px 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.3s var(--ease-out);
  }
  a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  a:hover {
    color: var(--text);
  }
  a.is-active {
    color: var(--accent);
  }
  a.is-active::after {
    transform: scaleX(1);
  }

  /* phone: compact chips */
  @media (max-width: 640px) {
    ol {
      gap: 6px;
      padding: 8px 0;
    }
    a {
      padding: 6px 11px;
      font-size: 10px;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    a::after {
      display: none;
    }
    a.is-active {
      border-color: var(--accent);
    }
  }
</style>
