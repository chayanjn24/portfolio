---
import { site, nav } from '@content/site';
import { pad2 } from '@lib/text';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const links = nav.map((l, i) => ({ ...l, n: pad2(i + 1), active: isActive(l.href) }));
const clock = `${site.clock.city} · <span data-clock data-tz="${site.clock.timeZone}">--:--</span> ${site.clock.suffix}`;
---

<header class="nav no-print" data-nav>
  <a href="/" data-label="Home" class="brand serif">{site.firstName} <em>{site.lastName}</em></a>

  <nav class="links" aria-label="Main">
    {
      links.map((l) => (
        <a href={l.href} data-label={l.label} class:list={['link', { 'is-active': l.active }]} aria-current={l.active ? 'page' : undefined}>
          <span class="dot" />
          {l.label}
          <sup>{l.n}</sup>
        </a>
      ))
    }
  </nav>
  <div class="clock"><span class="pulse"></span><span set:html={clock} /></div>

  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>Menu</button>
</header>

<div class="overlay no-print" id="mobile-menu" hidden data-menu>
  {
    links.map((l) => (
      <a href={l.href} data-label={l.label} class:list={['overlay-link', 'serif', { 'is-active': l.active }]}>
        <span>{l.n}</span>
        {l.label}
      </a>
    ))
  }
  <span class="label overlay-meta"><span set:html={clock} /> · {site.availability}</span>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 30);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
    btn.textContent = open ? 'Close' : 'Menu';
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  window.matchMedia('(max-width: 860px)').addEventListener('change', () => setOpen(false));

  const tick = () => {
    document.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => {
      try {
        el.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: el.dataset.tz });
      } catch {}
    });
  };
  tick();
  setInterval(tick, 15000);
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px var(--gutter);
    color: var(--text);
    border-bottom: 1px solid rgba(42, 39, 36, 0);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background 0.5s,
      border-color 0.5s;
  }
  .nav.is-scrolled,
  .nav.is-open {
    background: rgba(11, 10, 9, 0.72);
  }
  .nav.is-scrolled {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .brand {
    font-size: 24px;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1;
    color: var(--text);
  }

  .links {
    display: flex;
    gap: clamp(18px, 2.4vw, 34px);
  }
  .link {
    display: flex;
    gap: 7px;
    align-items: center;
    color: var(--text-2);
  }
  .link.is-active {
    color: var(--text);
  }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
  }
  .is-active .dot {
    opacity: 1;
  }
  sup {
    font-size: 9px;
    color: var(--muted);
  }

  .clock {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    color: var(--muted);
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .menu-btn {
    display: none;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 99px;
    padding: 10px 18px;
    min-height: 44px;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 100px var(--gutter) 40px;
  }
  .overlay[hidden] {
    display: none;
  }
  .overlay-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(52px, 15vw, 88px);
    line-height: 1;
    color: var(--text-2);
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }
  .overlay-link.is-active {
    color: var(--text);
  }
  .overlay-link span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .overlay-meta {
    margin-top: 24px;
  }

  @media (max-width: 860px) {
    .links,
    .clock {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>
