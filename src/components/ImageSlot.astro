---
/**
 * An image in a framed box. If `src` is empty, shows a labelled placeholder
 * (at `ratio`) so you can see where a photo still needs to go.
 * With `natural`, a real image keeps its own shape — nothing is cropped.
 */
interface Props {
  src?: string;
  alt?: string;
  /** Shown when there's no image yet. */
  placeholder: string;
  /** CSS aspect-ratio, e.g. '16/10'. */
  ratio: string;
  /** Show the whole image at its own aspect ratio instead of cropping it to `ratio`. */
  natural?: boolean;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', placeholder, ratio, natural = false, class: className, loading = 'lazy' } = Astro.props;
const whole = natural && !!src;
---

<div class:list={['slot', { whole }, className]} style={whole ? undefined : `aspect-ratio:${ratio}`}>
  {
    src ? (
      <img src={src} alt={alt} loading={loading} decoding="async" />
    ) : (
      <span class="empty">
        <span>+</span>
        {placeholder}
      </span>
    )
  }
</div>

<style>
  .slot {
    position: relative;
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .whole img {
    position: static;
    height: auto;
  }
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .empty span {
    font-family: var(--serif);
    font-size: 32px;
    line-height: 1;
    color: var(--dim);
  }
</style>
