---
// Self-hosted fonts (no Google Fonts request).
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@content/site';
import { ogSlug } from '@lib/og';

interface Props {
  /** Page name for the browser tab, e.g. 'Work'. Omit on the home page. */
  title?: string;
  description?: string;
  /** Show the big "Let's make the numbers talk" call-to-action in the footer. */
  footerCta?: boolean;
}

const { title, description = site.description, footerCta = true } = Astro.props;
const fullTitle = title ? `${title} — ${site.fullName}` : `${site.fullName} — ${site.role}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
// Link-preview card made for this page at build time (src/pages/og/[...slug].png.ts).
const ogImage = new URL(`/og/${ogSlug(Astro.url.pathname)}.png`, siteUrl).href;

// Tells Google who the site is about (shown in search results and knowledge panels).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  jobTitle: site.role,
  url: siteUrl.href,
  email: `mailto:${site.email}`,
  image: new URL('/images/portrait.jpg', siteUrl).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National Institute of Technology, Silchar' },
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B0A09" data-theme-color />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Link preview (LinkedIn, WhatsApp, Slack, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Saved light/dark choice, applied before first paint so the page never flashes the wrong theme. -->
    <script is:inline>
      try {
        if (localStorage.getItem('chayan-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('[data-theme-color]').setAttribute('content', '#F4F1EA');
        }
      } catch (e) {}
    </script>
    {
      import.meta.env.PROD && (
        <>
          {/* Vercel Web Analytics: cookie-free visit counts. Served by Vercel itself, so it only runs on the live site. */}
          <script is:inline>
            window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
          </script>
          <script is:inline defer src="/_vercel/insights/script.js" />
        </>
      )
    }
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer cta={footerCta} />

    <div class="aura no-print" aria-hidden="true"><i></i><i></i></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="curtain" id="curtain" aria-hidden="true"><span></span></div>

    <!-- Entry half of the page curtain: runs immediately so the page never flashes. -->
    <script is:inline>
      (function () {
        var c = document.getElementById('curtain');
        if (!c) return;
        var label = '';
        try {
          label = sessionStorage.getItem('cg-next') || '';
          sessionStorage.removeItem('cg-next');
        } catch (e) {}
        c.firstChild.textContent = label;
        var lift = function () {
          c.style.transform = 'translateY(-101%)';
        };
        setTimeout(lift, 260);
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) lift();
        });
      })();
    </script>
    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>

<style>
  /* Two soft accent glows drifting very slowly behind everything. */
  .aura {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .aura i {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(var(--accent-rgb), var(--aura, 0.09)), transparent);
    filter: blur(40px);
    will-change: transform;
  }
  .aura i:first-child {
    top: -30vmax;
    left: -20vmax;
    animation: drift-a 38s ease-in-out infinite alternate;
  }
  .aura i:last-child {
    bottom: -35vmax;
    right: -25vmax;
    animation: drift-b 46s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate(28vw, 22vh) scale(1.15);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(-30vw, -18vh) scale(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aura i {
      animation: none;
    }
  }
  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9997;
    opacity: var(--grain);
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .curtain {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    align-items: flex-end;
    padding: 0 var(--gutter) 40px;
    background: var(--accent);
    color: var(--bg);
    font: italic 400 clamp(56px, 12vw, 200px) / 0.9 var(--serif);
    transform: translateY(0);
    transition: transform 1s var(--ease-curtain);
  }
  :global(.js) .curtain {
    display: flex;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .curtain {
      display: none;
    }
  }
</style>
